# Chave da API da Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo e esforço do agente
AIA_MODEL=claude-opus-5-5
AIA_EFFORT=medium

# Telefone do Ricardo (só dígitos, com DDI). Opcional: dá para parear mandando o código.
OWNER_PHONE=

# Porta do servidor local (extensão conecta em ws://127.0.0.1:PORT/ext)
PORT=8787

# Fuso horário e hora do resumo diário (HH:MM)
TIMEZONE=America/Sao_Paulo
DIGEST_TIME=17:00

# Horas até uma proposta sem resposta expirar
PROPOSAL_TTL_HOURS=6

# Se true, a Aia manda "já vejo e te retorno" para o familiar enquanto espera aprovação
ACK_ENABLED=false

# Caminho do banco SQLite
DB_PATH=./data/aia.sqlite
