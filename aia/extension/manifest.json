{
  "manifest_version": 3,
  "name": "Aia - Secretária WhatsApp",
  "version": "0.1.0",
  "description": "Conecta o WhatsApp Web ao servidor local da Aia (127.0.0.1:8787).",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["vendor/wppconnect-wa.js", "page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Aia",
    "default_popup": "popup.html"
  }
}
