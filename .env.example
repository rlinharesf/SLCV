# ── Câmera ──────────────────────────────────────────────────────────────────
# URL RTSP:  rtsp://usuario:senha@192.168.1.100:554/stream1
# Snapshot:  http://192.168.1.100/snapshot.jpg
# Webcam:    0
CAMERA_URL=rtsp://usuario:senha@192.168.1.100:554/stream1

# ── Detecção ─────────────────────────────────────────────────────────────────
# DETECTION_MODEL=yolo   → YOLOv8n (mais preciso, ~6 MB, download automático)
# DETECTION_MODEL=hog    → OpenCV HOG (sem download, menos preciso)
DETECTION_MODEL=yolo
DETECTION_CONFIDENCE=0.5

# Segundos entre cada captura de frame (1.0 = 1 frame por segundo)
CHECK_INTERVAL=1.0

# Tempo mínimo entre alertas para evitar spam de email (segundos)
COOLDOWN_SECONDS=60

# ── Email (Gmail recomendado) ─────────────────────────────────────────────────
# Para Gmail: ative "Verificação em dois fatores" e crie uma "Senha de app"
# em https://myaccount.google.com/apppasswords
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=seuemail@gmail.com
EMAIL_PASSWORD=sua_app_password_aqui
EMAIL_TO=destinatario@email.com

# ── Saída ────────────────────────────────────────────────────────────────────
SNAPSHOTS_DIR=snapshots
LOG_FILE=detections.log
WEB_PORT=5000
